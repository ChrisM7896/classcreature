<header class="site-header">
  <a class="brand" href="/">
    <%= typeof appName !=='undefined' ? appName : 'App' %>
  </a>
  <nav>
    <a href="/">Home</a>
    <% if (typeof currentUser !=='undefined' && currentUser) { %>
      <a href="/example">Example</a>
      <a href="/inventory">Inventory</a>
      <a href="/stats">Stats</a>
      <a href="/account">Account</a>
      <button type="button" id="JOURNAL_BUTTON">Open Journal</button>
      <form class="inline" method="post" action="/auth/logout">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
        <button type="submit">Sign out</button>
      </form>
      <% } else { %>
        <a href="/auth/login">Sign in</a>
        <% } %>
  </nav>
</header>

<script nonce="<%= cspNonce %>" src="/socket.io/socket.io.js"></script>
<script nonce="<%= cspNonce %>" src="/js/header-socket.js"></script>
<script nonce="<%= cspNonce %>" src="/js/header.js"></script>